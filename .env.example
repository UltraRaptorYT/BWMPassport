# Required for both authentication methods. Use the ID from the destination
# folder URL: https://drive.google.com/drive/folders/FOLDER_ID
GOOGLE_DRIVE_FOLDER_ID=your-google-drive-folder-id

# Option 1: OAuth credentials for a personal Google Drive or Workspace user.
GOOGLE_CLIENT_ID=your-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-oauth-client-secret
GOOGLE_REFRESH_TOKEN=your-oauth-refresh-token

# Option 2: Service account credentials for a Workspace Shared Drive.
# Leave the OAuth variables above empty when using this option.
# GOOGLE_SERVICE_EMAIL=bw-monastery@bw-monastery-737764.iam.gserviceaccount.com
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"

# Optional: a Workspace user to impersonate when domain-wide delegation is enabled.
# GOOGLE_DRIVE_IMPERSONATED_USER=drive-owner@example.com
